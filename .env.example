# =====================================================================
# PORTFOLIO CONTACT FORM - ENVIRONMENT VARIABLES
# =====================================================================
# Rename this file to .env or .env.local for local testing, or configure
# these environment variables in your hosting provider (Vercel, Netlify, etc.)
# =====================================================================

# Destination Inbox where inquiries will be received:
CONTACT_TO_EMAIL=ssrahman2002@gmail.com

# ---------------------------------------------------------------------
# OPTION 1: GMAIL SMTP CONFIGURATION (Recommended for Gmail delivery)
# ---------------------------------------------------------------------
# Note: Google requires a 16-character App Password when 2-Factor
# Authentication is enabled. Do NOT use your regular Google account password.
# To generate a Gmail App Password:
# 1. Go to https://myaccount.google.com/apppasswords
# 2. Name it "Portfolio Website" and click Create
# 3. Copy the generated 16-character code (e.g. abcd efgh ijkl mnop)
# ---------------------------------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=ssrahman2002@gmail.com
SMTP_PASS=your-16-character-google-app-password
SMTP_FROM="Portfolio Contact Form <ssrahman2002@gmail.com>"

# ---------------------------------------------------------------------
# OPTION 2: RESEND API (Alternative transactional email provider)
# ---------------------------------------------------------------------
# If you prefer Resend (https://resend.com):
# RESEND_API_KEY=re_your_resend_api_key_here
